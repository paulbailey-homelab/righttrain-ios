<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>RightTrain</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>$(PRODUCT_NAME)</string>
		<key>CFBundlePackageType</key>
		<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
		<key>CFBundleShortVersionString</key>
		<string>$(MARKETING_VERSION)</string>
		<key>CFBundleVersion</key>
		<string>$(CURRENT_PROJECT_VERSION)</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleURLName</key>
				<string>RightTrain</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>righttrain</string>
				</array>
			</dict>
		</array>
		<key>ITSAppUsesNonExemptEncryption</key>
		<false />
		<key>RightTrainAPIBaseURL</key>
		<string>$(RIGHTTRAIN_API_BASE_URL)</string>
		<key>RightTrainAPNsEnvironment</key>
		<string>$(RIGHTTRAIN_APNS_ENVIRONMENT)</string>
		<key>LSApplicationCategoryType</key>
		<string>public.app-category.navigation</string>
		<key>NSSupportsLiveActivities</key>
		<true />
		<key>NSSupportsLiveActivitiesFrequentUpdates</key>
		<true />
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>RightTrain uses your location when you choose nearest stations, and after you create a journey to update station guidance near your origin station.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>RightTrain uses location in the background while you have a pinned journey to detect when you reach your origin station and whether you caught the selected train.</string>
		<key>UIBackgroundModes</key>
		<array>
			<string>fetch</string>
			<string>location</string>
		</array>
		<key>BGTaskSchedulerPermittedIdentifiers</key>
		<array>
			<string>com.righttrain.ios.journey-sync</string>
		</array>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true />
		<key>UILaunchScreen</key>
		<dict>
			<key>UIColorName</key>
			<string>LaunchBackground</string>
		</dict>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
	</dict>
</plist>
